{
  "name": "rando",
  "version": "0.1.0",
  "description": "Rando, un jeu d'exploration fait avec Levain",
  "homepage": "https://github.com/PhantomDO/Rando",
  "license": "MIT",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "doctest",
    {
      "name": "directx-dxc",
      "host": true
    },
    "flecs",
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        {
          "name": "vulkan",
          "platform": "!emscripten"
        }
      ]
    },
    "fastgltf",
    "glm",
    "joltphysics",
    "ktx",
    "meshoptimizer",
    "nvrhi",
    "ozz-animation",
    {
      "name": "shader-slang",
      "host": true
    },
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "vulkan",
          "platform": "!emscripten"
        },
        {
          "name": "wayland",
          "platform": "!emscripten"
        },
        {
          "name": "x11",
          "platform": "!emscripten"
        }
      ]
    },
    "spdlog",
    "stb",
    {
      "name": "tracy",
      "platform": "!emscripten"
    },
    {
      "name": "vk-bootstrap",
      "platform": "!emscripten"
    }
  ],
  "vcpkg-configuration": {
    "overlay-ports": [
      "./ports"
    ]
  }
}
